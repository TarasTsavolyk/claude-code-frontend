{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/pre-commit-gate.mjs"],
            "timeout": 600
          }
        ]
      }
    ]
  },
  "permissions": {
    "defaultMode": "plan",
    "allow": [
      "Bash(npm run lint)",
      "Bash(npm run typecheck)",
      "Bash(npm run type-check)",
      "Bash(npm run test)",
      "Bash(npm run test:unit)",
      "Bash(npm run build)",
      "Bash(pnpm run lint)",
      "Bash(pnpm run typecheck)",
      "Bash(pnpm run type-check)",
      "Bash(pnpm run test)",
      "Bash(pnpm run test:unit)",
      "Bash(pnpm run build)",
      "Bash(yarn run lint)",
      "Bash(yarn run typecheck)",
      "Bash(yarn run type-check)",
      "Bash(yarn run test)",
      "Bash(yarn run test:unit)",
      "Bash(yarn run build)",
      "Bash(bun run lint)",
      "Bash(bun run typecheck)",
      "Bash(bun run type-check)",
      "Bash(bun run test)",
      "Bash(bun run test:unit)",
      "Bash(bun run build)"
    ],
    "ask": ["Bash(git push:*)", "Bash(git commit:*)", "Bash(rm:*)"],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -fd:*)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Edit(**/*.pem)"
    ]
  }
}
